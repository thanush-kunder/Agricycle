PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agricycle?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_change_me
CLIENT_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
MAX_FILE_SIZE_MB=5

# AI Large Language Model & Vision Credentials
# Primary: Google Gemini API (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Alternative Provider: OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
